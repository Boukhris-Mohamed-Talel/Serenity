# Copy this file to `.env` in this same folder and fill real values.
# `.env` is ignored by git to keep credentials local.

# Server
SERVER_PORT=8085

# Database
DB_URL=jdbc:mysql://localhost:3306/healthcare_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Security
# Use the same JWT secret used by your user/auth service (Base64 encoded).
JWT_SECRET=

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
APP_CORS_ALLOW_CREDENTIALS=true

# Monitoring AI (Python FastAPI)
MONITORING_AI_ENABLED=true
MONITORING_AI_URL=http://localhost:5150

# Weekly digest scheduler
MONITORING_WEEKLY_DIGEST_CRON=0 0 8 ? * MON
MONITORING_WEEKLY_DIGEST_TIMEZONE=Africa/Tunis

# Cleanup scheduler (delete entries older than retention days)
MONITORING_CLEANUP_CRON=0 0 3 * * ?
MONITORING_CLEANUP_TIMEZONE=Africa/Tunis
MONITORING_CLEANUP_RETENTION_DAYS=90

